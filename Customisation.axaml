<Window x:Class="Chess.Customisation"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Customisation" SizeToContent="WidthAndHeight">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Margin="10" Content="Light Square"/>
        <ColorPicker x:Name="lightSquarePicker" Grid.Column="1" Grid.Row="0" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="0" Grid.Row="1" Margin="10" Content="Dark Square"/>
        <ColorPicker x:Name="darkSquarePicker" Grid.Column="1" Grid.Row="1" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="0" Grid.Row="2" Margin="10" Content="Piece (Default)"/>
        <ColorPicker x:Name="defaultPiecePicker" Grid.Column="1" Grid.Row="2" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="0" Grid.Row="3" Margin="10" Content="Piece (Checked King)"/>
        <ColorPicker x:Name="checkKingPicker" Grid.Column="1" Grid.Row="3" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="0" Grid.Row="4" Margin="10" Content="Piece (Selected)"/>
        <ColorPicker x:Name="selectedPiecePicker" Grid.Column="1" Grid.Row="4" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="0" Grid.Row="5" Margin="10" Content="Checkmate Highlight"/>
        <ColorPicker x:Name="checkmatePicker" Grid.Column="1" Grid.Row="5" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="0" Grid.Row="6" Margin="10" Content="Last Move (Source)"/>
        <ColorPicker x:Name="lastMoveSourcePicker" Grid.Column="1" Grid.Row="6" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="2" Grid.Row="0" Margin="20,10,10,10" Content="Last Move (Destination)"/>
        <ColorPicker x:Name="lastMoveDestinationPicker" Grid.Column="3" Grid.Row="0" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="2" Grid.Row="1" Margin="20,10,10,10" Content="Best Move (Source)"/>
        <ColorPicker x:Name="bestMoveSourcePicker" Grid.Column="3" Grid.Row="1" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="2" Grid.Row="2" Margin="20,10,10,10" Content="Best Move (Destination)"/>
        <ColorPicker x:Name="bestMoveDestinationPicker" Grid.Column="3" Grid.Row="2" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="2" Grid.Row="3" Margin="20,10,10,10" Content="Available Move"/>
        <ColorPicker x:Name="availableMovePicker" Grid.Column="3" Grid.Row="3" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="2" Grid.Row="4" Margin="20,10,10,10" Content="Available Capture"/>
        <ColorPicker x:Name="availableCapturePicker" Grid.Column="3" Grid.Row="4" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="2" Grid.Row="5" Margin="20,10,10,10" Content="Available En Passant"/>
        <ColorPicker x:Name="availableEnPassantPicker" Grid.Column="3" Grid.Row="5" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
        <Label Grid.Column="2" Grid.Row="6" Margin="20,10,10,10" Content="Available Castle"/>
        <ColorPicker x:Name="availableCastlePicker" Grid.Column="3" Grid.Row="6" Margin="10" Width="180" ColorChanged="Picker_ColorChanged"/>
    </Grid>
</Window>
